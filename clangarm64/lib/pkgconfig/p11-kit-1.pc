prefix=/clangarm64
includedir=${prefix}/include
libdir=${prefix}/lib

p11_module_configs=/clangarm64/share/p11-kit/modules
p11_module_path=/clangarm64/lib/pkcs11
proxy_module=/clangarm64/lib/p11-kit-proxy.dll
p11_system_config_modules=/clangarm64/share/p11-kit/modules
p11_trust_paths=/clangarm64/etc/pki/ca-trust/source:/clangarm64/share/pki/ca-trust-source

Name: p11-kit
Description: Library and proxy module for properly loading and sharing PKCS#11 modules.
Version: 0.26.5
Libs: -L${libdir} -lp11-kit
Cflags: -I${includedir}/p11-kit-1
